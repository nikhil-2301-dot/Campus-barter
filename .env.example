# Campus Barter configuration. Copy to .env and fill in. NEVER commit .env.
# Flask does not read this file by itself: export the variables in your shell.
# In development every variable is optional (safe defaults are used).

# development | testing | production
APP_ENV=development

# Required in production: at least 32 random characters.
# Generate one:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Where the SQLite file lives. Default: instance/campus_barter.db
# In production point this at a persistent disk.
DATABASE_PATH=


# Optional, development only: password given to the demo users made by `flask --app app seed`.
# If empty, a random one is generated and printed once.
SEED_PASSWORD=

# Optional: DEBUG | INFO | WARNING | ERROR | CRITICAL. Default INFO. Logs are JSON lines on stdout.
# Passwords, tokens, cookies, query strings and request bodies are never logged.
LOG_LEVEL=

# Optional (C23): how many reverse proxies sit in front of the app (nginx, a host's load balancer). Default 0.
# With 1 or more, the app reads the visitor's address from X-Forwarded-For so rate limits count each visitor
# separately. Set it ONLY when a proxy really is in front: otherwise a visitor could fake the header.
TRUSTED_PROXIES=

# Optional, used by start.sh only: gunicorn worker count (default 2) and listen address (default 127.0.0.1:8000).
WEB_WORKERS=
BIND=
